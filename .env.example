# ==============================================================================
# AI-Evaluation Hackathon Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Google Gemini API
# If left empty, the application automatically switches to deterministic Safe Fallback Mock Mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Evaluation Runtime Options
ENABLE_MOCK_GEMINI=true
EVAL_MAX_CONCURRENCY=5
EVAL_TIMEOUT_MS=15000

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
